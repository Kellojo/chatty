# Required in production. If unset, a secret is generated and stored at <DATABASE_PATH dir>/.secret (mode 0600).
APP_SECRET=

# Auth
ENABLE_SIGNUP=true
ENABLE_PASSWORD_LOGIN=true
AUTO_PROMOTE_FIRST_USER=true

# OIDC (optional). OIDC_ONLY=true disables password login + sign-up.
#OIDC_ONLY=false
#OIDC_ISSUER=
#OIDC_CLIENT_ID=
#OIDC_CLIENT_SECRET=
#OIDC_SCOPES=openid profile email


# Agents / memory
AGENT_MAX_STEPS=25
MAX_ATTACHMENT_SIZE_MB=50

TZ=Europe/Berlin
#ORIGIN=https://chat.example.com

# Web Push (optional). Without keys, a pair is generated once and kept in the
# database. Push needs Chatty served over HTTPS (e.g. `tailscale serve`); the
# server only makes outbound calls to the browsers' push services.
# The subject is the contact push services see (Apple rejects localhost):
#VAPID_SUBJECT=mailto:you@example.com
#VAPID_PUBLIC_KEY=
#VAPID_PRIVATE_KEY=
